# Copy to .env and change both passwords and the secret key. .env is git-ignored.
ATLAS_OWNER_PASSWORD=change-me-owner
ATLAS_APP_PASSWORD=change-me-app
# Host folder mounted read-only at /sources inside worker and watch.
ATLAS_SOURCES_DIR=./sources
# Encrypts second-factor seeds. Generate with: openssl rand -base64 32
# Back it up apart from the database: without it nobody with a second factor can sign in.
ATLAS_SECRET_KEY=

# The name people type (Caddy serves TLS for it) and the edition of the interface (core or pro).
ATLAS_HOST=localhost
ATLAS_EDITION=core
# Folder with the model weights (bge-m3, bge-reranker-v2-m3, llm), mounted read-only into the model servers.
# ATLAS_MODELS_DIR=./models

# Models (optional; empty = off, and search degrades). The services run outside this Compose file for now.
# ATLAS_EMBED_URL=http://tei-embed:80          # text-embeddings-inference with bge-m3
# ATLAS_EMBED_TIMEOUT=60s                       # per call; empty keeps 5s. Raise it for the CPU-only Ollama trial
# ATLAS_RERANK_URL=http://tei-rerank:80        # text-embeddings-inference with bge-reranker-v2-m3
# ATLAS_LLM_URL=http://llm:8000/v1             # any OpenAI-compatible server: vLLM or Ollama
# ATLAS_LLM_MODEL=qwen-14b-instruct-awq

# Atlas Pro: the license is installed from Settings and kept in the data volume.
# Morse's public key is only read by a development build (devlicense).
# ATLAS_LICENSE_PUBLIC_KEY=

# Scheduled backups (docker compose --profile backup up -d; docs/OPERACION.md).
# ATLAS_BACKUP_AT=02:30                 # time of day, HH:MM, container time (UTC)
# ATLAS_BACKUP_KEEP=7                   # how many backups to keep
# ATLAS_BACKUP_DIR=../backups           # host folder that receives them
# ATLAS_BACKUP_GPG_RECIPIENT=           # encrypt every backup for this gpg key; put its public key in ATLAS_BACKUP_KEYS_DIR
# ATLAS_BACKUP_KEYS_DIR=./backup-keys

# Ajustes avanzados (opcionales)
# ATLAS_LOG_LEVEL=info                  # nivel de registro: debug, info, warn o error
# ATLAS_EMBED_API=tei                   # protocolo del servidor de embeddings: tei, o ollama para pruebas
# ATLAS_RERANK_TIMEOUT=5s               # tiempo máximo de la reordenación de resultados
# ATLAS_DB_MAX_CONNS=24                 # conexiones máximas de la API y el worker a Postgres
# ATLAS_SEARCH_COMMON_SHARE=0.02
# ATLAS_NETWORK_ISOLATED=true
# ATLAS_DOCLING_MEM=8g                  # memoria máxima del servicio de conversión de documentos (Docling)
# ATLAS_PG_SHM=1gb                      # memoria compartida del contenedor de Postgres
# ATLAS_PG_SHARED_BUFFERS=1GB           # memoria de caché de Postgres
# ATLAS_PG_CACHE=3GB                    # caché que Postgres supone disponible para sus consultas
# ATLAS_PG_MAINTENANCE_MEM=1GB          # memoria para tareas de mantenimiento de Postgres
# ATLAS_PG_MAINTENANCE_WORKERS=4        # procesos paralelos para el mantenimiento de Postgres
# ATLAS_PG_MAX_CONNECTIONS=200          # conexiones máximas que acepta Postgres
# ATLAS_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8@sha256:8de25e75ce39617f17f2f6c77d60a4f75b65e779ed5005420eb1400072a15c1c
# ATLAS_VLLM_IMAGE=vllm/vllm-openai:v0.33.0@sha256:d825baf9ce4b1b6bfc5ecc7b79880c7e6748c65a72d697ce3d47607aafa84c6e
# ATLAS_OLLAMA_IMAGE=ollama/ollama:0.40.16@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592
# ATLAS_EMBED_MODEL=bge-m3              # modelo de embeddings que descarga el servicio Ollama
# ATLAS_RERANK_TRIAL_MODEL=BAAI/bge-reranker-base   # modelo de reordenación del servicio rerank-cpu
# ATLAS_RERANK_MEM=4g                   # memoria máxima del servicio rerank-cpu
# ATLAS_OLLAMA_MEM=4g                   # memoria máxima del servicio Ollama
