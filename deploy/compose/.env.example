# Copy to .env and change both passwords and the secret key. .env is git-ignored.
ATLAS_OWNER_PASSWORD=change-me-owner
ATLAS_APP_PASSWORD=change-me-app
# Host folder mounted read-only at /sources inside worker and watch.
ATLAS_SOURCES_DIR=./sources
# Encrypts second-factor seeds. Generate with: openssl rand -base64 32
# Back it up apart from the database: without it nobody with a second factor can sign in.
ATLAS_SECRET_KEY=

# The name people type (Caddy serves TLS for it) and the edition of the interface (core or pro).
ATLAS_HOST=localhost
ATLAS_EDITION=core
# Folder with the model weights (bge-m3, bge-reranker-v2-m3, llm), mounted read-only into the model servers.
# ATLAS_MODELS_DIR=./models

# Models (optional; empty = off, and search degrades). The services run outside this Compose file for now.
# ATLAS_EMBED_URL=http://tei-embed:80          # text-embeddings-inference with bge-m3
# ATLAS_RERANK_URL=http://tei-rerank:80        # text-embeddings-inference with bge-reranker-v2-m3
# ATLAS_LLM_URL=http://llm:8000/v1             # any OpenAI-compatible server: vLLM or Ollama
# ATLAS_LLM_MODEL=qwen-14b-instruct-awq

# Atlas Pro: the signed license file (in ATLAS_LICENSE_DIR, ./license by default) and Morse's public key.
# ATLAS_LICENSE_FILE=/license/atlas.lic
# ATLAS_LICENSE_PUBLIC_KEY=
